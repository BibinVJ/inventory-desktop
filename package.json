{
  "name": "inventory-manager",
  "productName": "Inventory Manager",
  "version": "1.0.0",
  "description": "POS for inventory manager",
  "main": "main.js",
  "scripts": {
    "start": "concurrently \"vite\" \"npm run electron:dev\"",
    "electron:dev": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "build:prod": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:prod && npm run build:electron",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "package": "npm run build && electron-builder --dir --config.asar=false --config.directories.output=release",
    "dist": "npm run build && electron-builder --config.asar=false",
    "dist:win": "npm run build && electron-builder --win --config.asar=false",
    "dist:mac": "npm run build && electron-builder --mac --config.asar=false",
    "dist:linux": "npm run build && electron-builder --linux --config.asar=false",
    "publish": "npm run build && electron-builder --publish=always"
  },
  "keywords": [],
  "author": {
    "name": "bibin francis",
    "email": "bibinfrancis3937@gmail.com"
  },
  "license": "MIT",
  "dependencies": {
    "axios": "^1.11.0",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.1",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^8.1.0",
    "flatpickr": "^4.6.13",
    "lucide-react": "^0.541.0",
    "nprogress": "^0.2.0",
    "process": "^0.11.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router": "^7.8.1",
    "sonner": "^2.0.7",
    "swiper": "^11.2.10",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "crypto-browserify": "^3.12.1",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "electron-is-dev": "^3.0.1",
    "electron-updater": "^6.6.2",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "lightningcss": "^1.30.1",
    "nodemon": "^3.1.10",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "postcss": "^8.5.6",
    "rimraf": "^6.0.1",
    "stream-browserify": "^3.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^5.4.19",
    "vite-plugin-svgr": "^4.5.0",
    "vm-browserify": "^1.1.2",
    "wait-on": "^8.0.4"
  }
}
